#!/bin/bash
# Aporius launcher.
#
# Aporius is a built (static) Vite/React web app. This script serves its
# finished files with a small local web server and opens them in a Google
# Chrome "app mode" window, so the Dock icon behaves exactly like
# PopcornReading and Saturday Morning Cartoons.
#
# The Desktop is locked down by macOS security (TCC): when this app is
# double-clicked, launchd runs it with NO permission to read files inside the
# Desktop folder ("Operation not permitted"), so a server pointed at the Desktop
# copy can never start. To avoid that, the runnable copy of the site is kept in
# ~/Library/Application Support/Aporius (a non-protected location) and served
# from there. The icon still lives on the Desktop where you want it.
#
# No Node is needed at runtime -- we reuse the Python 3.13 already installed for
# the other apps. The served copy is refreshed automatically by `npm run build`
# (see scripts/sync-app.mjs), so there is no separate update step to remember.
#
# The server sends no-store on every response, so the Chrome window can never
# render an older build than the files sitting in APP_HOME.

DBG=/tmp/aporius_launch.log
exec 2>>"$DBG"
echo "===== launch $(date) =====" >>"$DBG"

APP_HOME="$HOME/Library/Application Support/Aporius"
DIST="$APP_HOME/dist"
PORT=8890
PIDFILE="/tmp/aporius_server.pid"
SRVLOG="/tmp/aporius_server.log"

PY3="/Library/Frameworks/Python.framework/Versions/3.13/bin/python3"
[ -x "$PY3" ] || PY3="$(command -v python3)"

# Kill any previous instance (recorded pid + anything squatting the port).
if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    sleep 0.3
fi
PORT_PIDS="$(lsof -tiTCP:$PORT -sTCP:LISTEN 2>/dev/null)"
if [ -n "$PORT_PIDS" ]; then
    kill $PORT_PIDS 2>/dev/null; sleep 0.5
    kill -9 $PORT_PIDS 2>/dev/null; sleep 0.3
fi

# Start the static web server (no-store on every response) from the
# non-protected copy.
cd "$DIST" || { echo "dist not found: $DIST" >>"$DBG"; exit 1; }
echo "serving build: $(cat "$APP_HOME/BUILD_STAMP" 2>/dev/null || echo unknown)" >>"$DBG"
if [ -f "$APP_HOME/serve.py" ]; then
    nohup "$PY3" "$APP_HOME/serve.py" "$PORT" "$DIST" >> "$SRVLOG" 2>&1 &
else
    echo "serve.py missing - falling back to cached http.server" >>"$DBG"
    nohup "$PY3" -m http.server "$PORT" --bind 127.0.0.1 >> "$SRVLOG" 2>&1 &
fi
echo $! > "$PIDFILE"

# Wait for the server to actually accept connections before opening the window.
for i in $(seq 1 30); do
    if curl -s -o /dev/null --max-time 1 "http://localhost:$PORT/"; then break; fi
    sleep 0.5
done

open -na "Google Chrome" --args --app="http://localhost:$PORT" --window-size=430,860

# Keep this process alive so the Dock icon stays until the server stops.
while [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; do
    sleep 5
done
