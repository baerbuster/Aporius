{
  "name": "aporius",
  "private": true,
  "version": "0.1.0",
  "description": "A voice-only philosophical interlocutor who murmurs your own sentences back at you while he thinks.",
  "author": "Buster Baer",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baerbuster/Aporius.git"
  },
  "keywords": [
    "voice-assistant",
    "speech-to-text",
    "text-to-speech",
    "claude",
    "anthropic",
    "deepgram",
    "elevenlabs",
    "react",
    "philosophy"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/sync-app.mjs",
    "build:only": "vite build",
    "build:phone": "APORIUS_PWA=1 vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
